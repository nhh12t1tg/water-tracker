<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Strictly Required Permissions for Water Tracker & AdMob Monetization -->
    <!-- 1. INTERNET: Required for AdMob ad requests and GDPR UMP consent updates -->
    <uses-permission android:name="android.permission.INTERNET" />
    
    <!-- 2. VIBRATE: Required for tactile feedback when user logs water consumption -->
    <uses-permission android:name="android.permission.VIBRATE" />
    
    <!-- 3. POST_NOTIFICATIONS: Required on Android 13+ (API 33+) for hydration reminders -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Google Play Compliance Notice: Zero invasive permissions (No Location, No Camera, No Storage) -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WaterTracker">

        <!-- Google AdMob Application ID (Configured via manifestPlaceholders / environment variables) -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${ADMOB_APP_ID}" />

        <!-- Google User Messaging Platform (UMP) compliance flag -->
        <meta-data
            android:name="com.google.android.gms.ads.flag.OPTIMIZE_INITIALIZATION"
            android:value="true" />
        <meta-data
            android:name="com.google.android.gms.ads.flag.OPTIMIZE_AT_START"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.WaterTracker"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
